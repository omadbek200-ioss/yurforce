[Unit]
Description=YurForce Node Server
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/yurforce
EnvironmentFile=/var/www/yurforce/.env
ExecStart=/usr/bin/node /var/www/yurforce/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
